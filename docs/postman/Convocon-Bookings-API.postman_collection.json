						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"token\": \"{{token}}\",\n    \"phone\": \"{{phone}}\",\n    \"name\": \"{{name}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{api_endpoint}}api/wpbox/makeContact",
							"host": [
								"{{api_endpoint}}api"
							],
							"path": [
								"wpbox",
								"makeContact"
							]
						},
						"description": "Creates or updates a Wpbox contact.\n\n**Required:** `token`, `phone`\n\n**Optional:** `name`, `email`, `groups` (comma-separated names), `custom` (object of field name → value)\n\nThis endpoint is separate from Bookings. Do not call it as a prerequisite for `makeReservation`."
					},
					"response": []
				}
			]
		}
	]
