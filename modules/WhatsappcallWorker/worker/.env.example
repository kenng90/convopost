PORT=8787
HOST=127.0.0.1
# Local Laravel URL (php artisan serve) — NOT your ngrok URL
WHATSAPP_AI_LARAVEL_CALLBACK_URL=http://127.0.0.1:8000
LARAVEL_APP_URL=http://127.0.0.1:8000
WHATSAPP_AI_WORKER_SECRET=change-me
WORKER_FETCH_TIMEOUT_MS=60000
# realtime = spoken OpenAI voice (requires OPENAI_API_KEY). stub = silent test mode.
WHATSAPP_AI_WORKER_MODE=realtime
WORKER_MODE=realtime
WORKER_DEBUG=1
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=alloy
OPENAI_REALTIME_TEMPERATURE=0.7
WHATSAPP_AI_MAX_CALL_MS=900000
